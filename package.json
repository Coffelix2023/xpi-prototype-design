{
  "name": "@fx-pi/xpi-prototype-design",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "files": ["THEMES.md", "skills", "src"],
